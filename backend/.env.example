# Copy to backend/.env and adjust. Every value here is a safe, non-secret example.

# development | test | production
AVS_ENVIRONMENT=development

# Comma-separated origins allowed to call the API (the Next.js dev server by default).
# Never use * in production; the app refuses to start with it.
AVS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Serve interactive docs at /docs and the schema at /api/v1/openapi.json
AVS_DOCS_ENABLED=true

# Largest accepted request body in bytes
AVS_MAX_REQUEST_BYTES=65536

# --- Local text-to-image model (Phase 4) -------------------------------------------
# No API keys are needed: the model runs on this machine.

# diffusers = local open-weight model, none = turn generation off
IMAGE_ENGINE=diffusers
# Hugging Face repo ID. Default: RealVisXL V5.0 Lightning (photoreal SDXL, CreativeML Open RAIL++-M).
# stabilityai/sd-turbo is faster but much lower quality (Stability AI Community License).
IMAGE_MODEL_ID=SG161222/RealVisXL_V5.0_Lightning
# Where downloaded weights live (relative paths are resolved from backend/).
IMAGE_MODEL_CACHE_DIR=models
# Where generated PNGs are written and served from.
IMAGE_OUTPUT_DIR=outputs/images
# auto = CUDA if PyTorch sees a GPU, else CPU. Or force cuda / cpu.
IMAGE_DEVICE=auto
# GPU work is heavy: keep 1 unless you have VRAM to spare.
IMAGE_MAX_CONCURRENT_JOBS=1
IMAGE_MAX_QUEUED_JOBS=8
# Seconds before a running job is stopped and marked failed.
IMAGE_TIMEOUT_SECONDS=600
# auto enables these only on GPUs with small VRAM (<=6 GB slicing, <4 GB offload).
IMAGE_ATTENTION_SLICING=auto
IMAGE_CPU_OFFLOAD=auto

# --- Local text-to-video model (Phase 5) -------------------------------------------
# Wan2.1 T2V 1.3B (Apache-2.0), ~29 GB download. See README "Text to video".

# wan = local Wan2.1 model, none = turn video off
VIDEO_ENGINE=wan
VIDEO_MODEL_ID=Wan-AI/Wan2.1-T2V-1.3B-Diffusers
# Empty = share IMAGE_MODEL_CACHE_DIR
VIDEO_MODEL_CACHE_DIR=
VIDEO_OUTPUT_DIR=outputs/videos
VIDEO_DEVICE=auto
# Wan's native frame rate; clips are 2, 3 or 5 s (at most 81 frames)
VIDEO_FPS=16
# Used when a request does not set steps (10-50 allowed)
VIDEO_DEFAULT_STEPS=25
# Wan's recommended guidance and flow shift (3.0 suits 480p and below)
VIDEO_GUIDANCE_SCALE=5.0
VIDEO_FLOW_SHIFT=3.0
# The 11 GB text encoder runs on the CPU so the transformer fits an 8 GB GPU. Needs ~15 GB free RAM.
VIDEO_TEXT_ENCODER_ON_CPU=true
VIDEO_ENABLE_VAE_TILING=true
# Seconds before a running video job is stopped and marked failed
VIDEO_TIMEOUT_SECONDS=3600
VIDEO_MAX_QUEUED_JOBS=2
