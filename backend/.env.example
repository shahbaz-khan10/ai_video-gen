# Copy to backend/.env and adjust. Every value here is a safe, non-secret example.

# development | test | production
AVS_ENVIRONMENT=development

# Comma-separated origins allowed to call the API (the Next.js dev server by default).
# Never use * in production; the app refuses to start with it.
AVS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Serve interactive docs at /docs and the schema at /api/v1/openapi.json
AVS_DOCS_ENABLED=true

# Largest accepted request body in bytes
AVS_MAX_REQUEST_BYTES=65536

# --- Local text-to-image model -------------------------------------------------
# No API keys are needed: the model runs on this machine. Weights are downloaded once with
#   python scripts/download_model.py
# (internet required for that step only).

# diffusers = local model, none = generation disabled
IMAGE_ENGINE=diffusers

# Hugging Face model ID (or a local folder containing model_index.json)
IMAGE_MODEL_ID=stabilityai/sd-turbo

# Weight variant; fp16 downloads only the half-precision files (~2.6 GB for sd-turbo)
IMAGE_MODEL_VARIANT=fp16

# Generated PNGs (relative paths resolve against backend/)
IMAGE_OUTPUT_DIR=outputs/images

# Model weight cache. Leave empty for the standard Hugging Face cache (~/.cache/huggingface)
IMAGE_MODEL_CACHE_DIR=

# The API never downloads weights by itself unless this is true
IMAGE_ALLOW_DOWNLOAD=false

# auto (CUDA if available, else CPU), cuda, or cpu. CPU works but is much slower.
IMAGE_DEVICE=auto

# Images generated at the same time. Keep 1 for a single consumer GPU.
IMAGE_MAX_CONCURRENT_JOBS=1

# Waiting + running jobs before new requests get 429
IMAGE_MAX_QUEUED_JOBS=8

# SD-Turbo: 1-4 steps, guidance 0.0. Raise both for non-turbo models.
IMAGE_MAX_STEPS=4
IMAGE_GUIDANCE_SCALE=0.0

IMAGE_GENERATION_TIMEOUT_SECONDS=300

# VRAM savers for smaller GPUs (slower). Not needed for sd-turbo on 8 GB.
IMAGE_ATTENTION_SLICING=false
IMAGE_CPU_OFFLOAD=false
